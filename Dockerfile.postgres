# to run after building image docker run -d --name localhostdb --env-file .env -p 5432:5432 <image>
FROM postgres:16-alpine

# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB are supplied at runtime via --env-file .env

# Initialize only the operational database on a fresh pgdata volume.
# The reporting schema belongs to the separate postgres-olap service.
COPY ./initdb/oltp_schema.sql /docker-entrypoint-initdb.d/01-oltp-schema.sql

EXPOSE 5432
